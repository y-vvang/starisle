# 本地跑 Node(npm start / npm run migrate,不经过 Docker Compose)时,Postgres
# 监听宿主机的 localhost:5432 —— 这时 DATABASE_URL 的 host 用 localhost/127.0.0.1。
#
# 用 docker compose up -d 起 app 容器时,不要用这份 .env.example/.env 里的
# DATABASE_URL —— app 和 db 是两个容器,host 必须是 compose 服务名 db,不是
# localhost(容器里的 localhost 是 app 自己),而且 docker-compose.yml 里
# DATABASE_URL 没有默认值,必须显式设置,否则 app 容器起来就崩溃重启。
# 完整的 Docker Compose 变量写法见 docs/DEPLOY.md 第 2 节。
DATABASE_URL=postgres://starisle:devpass@localhost:5432/starisle
TEST_DATABASE_URL=postgres://starisle:devpass@localhost:5432/starisle_test

# 本地跑 npm run migrate / npm start 时,起本地 Postgres 容器(见 README 快速开始
# 第 0 步)用的密码,要和上面 DATABASE_URL/TEST_DATABASE_URL 里的密码一致。
# 这只是本地开发默认值 —— 生产部署(Docker Compose)必须在 .env 里换成强密码,
# 见 docs/DEPLOY.md 第 2 节,docker-compose.yml 里这个变量没有默认值,不设会
# 直接报错拒绝启动。
POSTGRES_PASSWORD=devpass

SESSION_SECURE=0
PORT=4870
