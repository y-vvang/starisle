{
  "name": "starisle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "星屿 Starisle · Bun + TypeScript + PostgreSQL 全栈项目协作社区(真实账号,Docker Compose 部署)",
  "scripts": {
    "start": "bun app/server.ts",
    "db:up": "docker compose up -d db",
