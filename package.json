    "create-admin": "bun app/bin/create-admin.ts",
    "seed": "bun app/bin/import-seed.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.5.0"
  }
}
